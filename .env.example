# Copy to .env and replace these values before running docker compose.
MODEM_PASSWORD=replace-me
GRAFANA_ADMIN_PASSWORD=replace-me
# Set MODEM_URL only if the modem is not at the default address.
# MODEM_URL=https://192.168.100.1

# Optional: pin the modem's TLS certificate instead of falling back to
# --insecure-tls. Get it with:
#   openssl s_client -connect 192.168.100.1:443 </dev/null 2>/dev/null \
#     | openssl x509 -noout -fingerprint -sha256
# MODEM_TLS_FINGERPRINT=SHA256:AA:BB:...
